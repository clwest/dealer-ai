# ----------------------------------------------------------------------------
# Dealer OS Dealer AI — backend environment
# Copy to backend/.env and edit. Anything left blank uses the default.
# ----------------------------------------------------------------------------

# ---- Django -----------------------------------------------------------------
DJANGO_SECRET_KEY=change-me-in-prod
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# ---- Database ---------------------------------------------------------------
# Leave POSTGRES_DB / POSTGRES_USER blank to use SQLite (default for local dev).
# Set both to switch to Postgres.
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# ---- LLM provider -----------------------------------------------------------
# DEALER_AI_LLM_PROVIDER picks which backend handles every chat completion.
#
#   ollama (default) — runs locally, FREE, no API key needed.
#                      Setup: install from https://ollama.com, then:
#                        ollama pull llama3.1
#                        ollama serve
#                      Default URL is http://localhost:11434.
#
#   openai           — OpenAI Chat Completions. Costs per token. Requires
#                      OPENAI_API_KEY. Use this if you don't want to run a
#                      local model or you want sharper output.
#
# If the configured provider is unavailable (e.g. Ollama not running), the
# chat returns a clear fallback message — the app keeps working but the
# customer sees a "trouble reaching the AI model" reply.
DEALER_AI_LLM_PROVIDER=ollama

# ---- Ollama (local, free, default) -----------------------------------------
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1

# ---- OpenAI (optional, paid) ------------------------------------------------
# Only needed if DEALER_AI_LLM_PROVIDER=openai. Leave blank otherwise.
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# ---- CORS -------------------------------------------------------------------
# Add the Vite dev server and any other origins that should hit /api directly.
# In dev, the Vite proxy makes most CORS issues a non-event.
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000
